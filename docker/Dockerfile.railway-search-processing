# syntax=docker/dockerfile:1
FROM rust:latest AS chef
ENV SQLX_OFFLINE=true
WORKDIR /app

FROM chef AS builder

# cmake is needed to compile librdkafka from source.
RUN apt-get update && apt-get install -y --no-install-recommends cmake && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --release --bin search_processing_service && \
  strip /app/target/release/search_processing_service && \
  cp /app/target/release/search_processing_service /app/svc && \
  test -s /app/services/search_processing_service/pdfium-lib/linux/libpdfium.so

FROM debian:trixie-slim AS runner
WORKDIR /app

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates dumb-init libstdc++6 && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 --from=builder /app/svc /app/svc
COPY --from=builder /app/services/search_processing_service/pdfium-lib/linux /app/pdfium-lib/linux

ENV PORT=8080
ENV LD_LIBRARY_PATH=/app/pdfium-lib/linux
EXPOSE 8080

ENTRYPOINT ["dumb-init", "./svc"]
