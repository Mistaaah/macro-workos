:{$PORT:8080} {
	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	redir / /app/ 302

	handle /auth {
		reverse_proxy macro-workos.railway.internal:8080
	}
	handle_path /auth/* {
		reverse_proxy macro-workos.railway.internal:8080
	}

	handle /app/* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Do not return an empty 200 for API paths that have no backend route yet.
	# The web client treats that as successful data and can crash while reading it.
	respond 404
}
